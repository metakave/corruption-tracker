# PostgreSQL
DATABASE_URL=postgresql://tracker:changeme@localhost:5432/tracker_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# S3-compatible object storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tracker-files
S3_REGION=us-east-1

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change_this_master_key

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat
