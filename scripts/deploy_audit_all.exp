#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload fix script
spawn scp -o StrictHostKeyChecking=no scripts/audit_all_date_mismatches.ts $user@$ip:$remote_path/scripts/audit_all_date_mismatches.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

# Execute Fix
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "npx tsx scripts/audit_all_date_mismatches.ts\r"
expect "#"
send "exit\r"
expect eof
