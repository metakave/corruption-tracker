#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"
set local_file "scripts/find_sources_for_titles.ts"
set remote_file "$remote_path/scripts/find_sources_for_titles.ts"

# Upload
spawn scp -o StrictHostKeyChecking=no $local_file $user@$ip:$remote_file
expect {
    "password:" { send "$password\r" }
}
expect eof

# Execute
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "password:"
send "$password\r"
expect "#"

send "cd $remote_path\r"
send "npx tsx scripts/find_sources_for_titles.ts\r"
expect {
    -re "root@.*#" { }
}

send "exit\r"
expect eof
