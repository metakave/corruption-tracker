#!/usr/bin/expect

set timeout 30
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" { send "$password\r" }
}
expect "#"

send "cat /etc/nginx/sites-enabled/default\r"
expect "#"

send "ls -la /etc/nginx/conf.d/\r"
expect "#"

send "exit\r"
expect eof
