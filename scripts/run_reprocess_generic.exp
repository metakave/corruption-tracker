
#!/usr/bin/expect -f

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

# 1. Upload Library Change (AI Logic + Event Processor Fix)
spawn scp -o StrictHostKeyChecking=no lib/ai-analysis.ts lib/event-processor.ts $user@$ip:/var/www/political_violence_tracker/lib/
expect {
    -re "(?i)password:" { send "$password\r" }
}
expect eof

# 2. Upload Reprocess Script
spawn scp -o StrictHostKeyChecking=no scripts/reprocess_generic.ts $user@$ip:/var/www/political_violence_tracker/scripts/
expect {
    -re "(?i)password:" { send "$password\r" }
}
expect eof

# 3. Execute
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    -re "(?i)password:" { send "$password\r" }
}

expect "root@"
send "cd /var/www/political_violence_tracker\r"
expect "#"

# No need to rebuild app for script execution, tsx runs source directly
send "npx tsx scripts/reprocess_generic.ts\r"
expect {
    "Analyzing with FIXED Event Processor logic" {}
}
expect "#"

send "exit\r"
expect eof
