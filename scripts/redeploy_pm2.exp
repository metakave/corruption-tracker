#!/usr/bin/expect -f

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "password:"
send "$password\r"

expect "#"
send "cd /var/www/political_violence_tracker\r"

expect "#"
send "echo 'Restarting application...'\r"
send "pm2 stop all || true\r"

expect "#"
send "pm2 delete all || true\r"

expect "#"
send "pkill -f next-server || true\r"

expect "#"
send "pm2 start npm --name 'political-violence-tracker' -- start\r"

expect "#"
send "pm2 start npx --name 'pvt-admin' -- prisma studio --port 5555\r"

expect "#"
send "pm2 save\r"

expect "#"
send "echo '✅ PM2 RESTART COMPLETE'\r"
send "exit\r"
expect eof
