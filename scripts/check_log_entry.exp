#!/usr/bin/expect

set timeout 30
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set title "কারওয়ান বাজারে ফের মোবাইল ফোন ব্যবসায়ীরা"

spawn ssh -o StrictHostKeyChecking=no $user@$ip "grep '$title' /var/www/political_violence_tracker/audit_trail.csv"
expect {
    "password:" { send "$password\r" }
}
expect eof
