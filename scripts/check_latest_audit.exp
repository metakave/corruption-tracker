#!/usr/bin/expect

set timeout 30
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

# Tail last 5 lines which should contain our latest run
spawn ssh -o StrictHostKeyChecking=no $user@$ip "tail -n 5 /var/www/political_violence_tracker/logs/audit_trail.csv"
expect {
    "password:" { send "$password\r" }
}
expect eof
