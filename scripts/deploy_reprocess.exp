#!/usr/bin/expect

set timeout 900
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload scripts/reprocess_deduplication.ts
spawn scp -o StrictHostKeyChecking=no scripts/reprocess_deduplication.ts $user@$ip:$remote_path/scripts/reprocess_deduplication.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

# Run the script
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "npx tsx scripts/reprocess_deduplication.ts\r"
expect "#"
send "exit\r"
expect eof
