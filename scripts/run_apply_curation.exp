
#!/usr/bin/expect -f

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

spawn scp -o StrictHostKeyChecking=no scripts/apply_curation.ts $user@$ip:/var/www/political_violence_tracker/scripts/
expect {
    -re "(?i)password:" { send "$password\r" }
}
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    -re "(?i)password:" { send "$password\r" }
}

expect "root@"
send "cd /var/www/political_violence_tracker\r"
expect "#"

send "npx tsx scripts/apply_curation.ts\r"
expect {
    "APPLYING MANUAL CURATION" {}
}
expect "#"

send "exit\r"
expect eof
