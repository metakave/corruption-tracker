#!/usr/bin/expect

set timeout 3600
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload script
spawn scp -o StrictHostKeyChecking=no scripts/reprocess_deduplication.ts $user@$ip:$remote_path/scripts/reprocess_deduplication.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

# Execute
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
# Load env vars just in case, though usually unnecessary for npx if .env exists
send "export \$(grep -v '^#' .env | xargs) && npx tsx scripts/reprocess_deduplication.ts\r"
expect "#"
send "exit\r"
expect eof
