#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload updated scripts (both pipeline and repair)
spawn scp -o StrictHostKeyChecking=no scripts/cleanup_pipeline_v2.ts scripts/repair_casualties.ts $user@$ip:$remote_path/scripts/
expect {
    "password:" { send "$password\r" }
}
expect eof

# Run repair script
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"

send "cd $remote_path\r"
expect "#"

send "npx tsx scripts/repair_casualties.ts\r"
expect "#"

send "exit\r"
expect eof
