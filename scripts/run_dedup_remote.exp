#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# 1. Upload the cleanup script
spawn scp -o StrictHostKeyChecking=no scripts/cleanup_pipeline_v2.ts $user@$ip:$remote_path/scripts/
expect {
    "password:" { send "$password\r" }
}
expect eof

# 2. SSH and run dry-run
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"

send "cd $remote_path\r"
expect "#"

# Run LIVE mode
send "npx tsx scripts/cleanup_pipeline_v2.ts\r"
expect "#"

puts "\n=== REMOTE EXECUTION COMPLETE ==="
send "exit\r"
expect eof
