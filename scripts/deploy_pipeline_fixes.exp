#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload fixed files
spawn scp -o StrictHostKeyChecking=no lib/event-processor.ts lib/ai-analysis.ts $user@$ip:$remote_path/lib/
expect {
    "password:" { send "$password\r" }
}
expect eof

# Restart PM2
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "pm2 restart all\r"
expect "#"
send "pm2 logs --lines 20 --nostream\r"
expect "#"
send "exit\r"
expect eof
