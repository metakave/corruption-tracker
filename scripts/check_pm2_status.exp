#!/usr/bin/expect -f

set timeout 30

puts "📡 Connecting to check PM2 status..."
spawn ssh -o StrictHostKeyChecking=no root@46.224.92.166
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"

expect "root@"
send "pm2 list\r"

expect "root@"
send "echo '--- PM2 LOGS ---'\r"
send "pm2 logs ai-pipeline --lines 50 --nostream\r"

expect "root@"
send "exit\r"
expect eof
