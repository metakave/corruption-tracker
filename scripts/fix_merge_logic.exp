#!/usr/bin/expect -f

set timeout 30

# 1. Upload simplified logic
puts "🚀 Uploading logic fix..."
spawn scp -o StrictHostKeyChecking=no lib/event-processor.ts root@46.224.92.166:/var/www/political_violence_tracker/lib/
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"
expect eof

# 2. Restart to apply
puts "🔄 Restarting AI Pipeline..."
spawn ssh -o StrictHostKeyChecking=no root@46.224.92.166
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"

expect "root@"
send "pm2 restart ai-pipeline\r"

expect "root@"
send "echo '--- RESTARTED ---'\r"
send "pm2 logs ai-pipeline --lines 10 --nostream\r"

expect "root@"
send "exit\r"
expect eof
