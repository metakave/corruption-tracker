#!/usr/bin/expect

set timeout 600
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload API route
spawn scp -o StrictHostKeyChecking=no app/api/events/route.ts $user@$ip:$remote_path/app/api/events/route.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

# Clean Rebuild
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "rm -rf .next node_modules/.cache\r"
expect "#"
send "npm run build\r"
expect "#"
send "pm2 restart all\r"
expect "#"
send "exit\r"
expect eof
