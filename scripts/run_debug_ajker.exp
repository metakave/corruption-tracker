#!/usr/bin/expect

set timeout 60
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set script_local "scripts/debug_ajker_patrika_dom.ts"
set script_remote "/var/www/political_violence_tracker/scripts/debug_ajker_patrika_dom.ts"

# 1. Upload
spawn scp -o StrictHostKeyChecking=no $script_local $user@$ip:$script_remote
