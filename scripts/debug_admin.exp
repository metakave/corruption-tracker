#!/usr/bin/expect

set timeout 20
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" { send "$password\r" }
}
expect "#"

send "echo '--- CHECKING NGINX ---'\r"
send "cat /etc/nginx/sites-enabled/default\r"
send "echo '--- CHECKING PRISMA STUDIO ---'\r"
send "pm2 describe prisma-studio\r"
send "netstat -tuln | grep 5555\r"
send "curl -I http://localhost:5555\r"
send "echo '--- END CHECKS ---'\r"
send "exit\r"
expect eof
