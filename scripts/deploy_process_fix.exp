#!/usr/bin/expect

set timeout 600
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload files
spawn scp -o StrictHostKeyChecking=no lib/db.ts next.config.ts $user@$ip:$remote_path/lib/
expect {
    "password:" { send "$password\r" }
}
expect eof

# Move next.config.ts to root (scp put it in lib temporarily or we can do it correctly)
# Let's target root for next.config.ts
spawn scp -o StrictHostKeyChecking=no next.config.ts $user@$ip:$remote_path/
expect {
    "password:" { send "$password\r" }
}
expect eof

spawn scp -o StrictHostKeyChecking=no lib/db.ts $user@$ip:$remote_path/lib/
expect {
    "password:" { send "$password\r" }
}
expect eof


# Rebuild
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "rm -rf .next node_modules/.cache\r"
expect "#"
send "npm run build\r"
expect "#"
send "pm2 restart all\r"
expect "#"
send "exit\r"
expect eof
