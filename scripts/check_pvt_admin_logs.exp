#!/usr/bin/expect

set timeout 30
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" { send "$password\r" }
}
expect "#"

send "echo '--- PM2 LOGS FOR pvt-admin ---'\r"
send "pm2 logs pvt-admin --lines 50 --no-daemon\r"
sleep 5
send "\x03"
expect "#"

send "exit\r"
expect eof
