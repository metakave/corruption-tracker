#!/usr/bin/expect

set timeout 60
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload debug script
spawn scp -o StrictHostKeyChecking=no scripts/debug_latest_events.ts $user@$ip:$remote_path/scripts/
expect {
    "password:" { send "$password\r" }
}
expect eof

# Execute
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path\r"
expect "#"
send "npx tsx scripts/debug_latest_events.ts\r"
expect "#"
send "exit\r"
expect eof
