#!/usr/bin/expect

set timeout 60
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Connect to server
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"

send "cd $remote_path\r"
expect "#"

# Cleanup any old run if exists
send "pm2 delete manual-crawler-run\r"
expect "#"

# Start the crawler via npx tsx
send "pm2 start \"npx tsx scripts/crawler.ts\" --name \"manual-crawler-run\" --no-autorestart\r"
expect "#"

send "exit\r"
expect eof
