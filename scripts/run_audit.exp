#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

spawn scp -o StrictHostKeyChecking=no scripts/audit_events.ts $user@$ip:$remote_path/scripts/
expect {
    "password:" { send "$password\r" }
}
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"

send "cd $remote_path\r"
send "npx tsx scripts/audit_events.ts > logs/full_audit_log.txt 2>&1\r"
expect "#"
send "cat logs/full_audit_log.txt\r"
expect "#"

send "exit\r"
expect eof
