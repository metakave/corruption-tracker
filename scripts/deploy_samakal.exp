#!/usr/bin/expect -f

set timeout -1

# Upload Samakal scraper
spawn scp -o StrictHostKeyChecking=no lib/scrapers/samakal.ts root@46.224.92.166:/var/www/political_violence_tracker/lib/scrapers/
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"
expect eof

# Upload test script  
spawn scp -o StrictHostKeyChecking=no scripts/count_samakal.ts root@46.224.92.166:/var/www/political_violence_tracker/scripts/
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"
expect eof

# SSH and run test
spawn ssh -o StrictHostKeyChecking=no root@46.224.92.166
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"

expect "root@"
send "cd /var/www/political_violence_tracker\r"

expect "#"
send "echo '🧪 TESTING SAMAKAL ON PRODUCTION...'\r"
send "\r"
send "npx tsx scripts/count_samakal.ts\r"

expect {
    "SAMAKAL_COUNT" {
        send "echo '\r\n=== DEPLOYMENT COMPLETE ==='\r"
    }
    timeout {
        send "echo '\r\n⚠️ Test encountered an error'\r"
    }
}

send "exit\r"
expect eof
