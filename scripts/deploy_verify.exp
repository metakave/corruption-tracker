#!/usr/bin/expect

set timeout 600
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"
set local_file "scripts/verify_reanalysis.ts"
set remote_file "$remote_path/scripts/verify_reanalysis.ts"

# Upload script
puts "\n--- UPLOADING VERIFICATION SCRIPT ---\n"
spawn scp -o StrictHostKeyChecking=no $local_file $user@$ip:$remote_file
expect {
    "password:" { send "$password\r" }
}
expect eof

# Execute
puts "\n--- RUNNING VERIFICATION ON SERVER ---\n"
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "password:"
send "$password\r"
expect "#"

send "cd $remote_path\r"
send "npx tsx scripts/verify_reanalysis.ts\r"

expect {
    "SUMMARY:" { exp_continue }
    -re "root@.*#" { }
    timeout { puts "Timeout waiting for script..." }
}

send "exit\r"
expect eof
