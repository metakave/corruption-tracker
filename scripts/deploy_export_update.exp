#!/usr/bin/expect

set timeout 60
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Create directories
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "mkdir -p $remote_path/app/api/admin/export-logs\r"
expect "#"
send "exit\r"
expect eof

# Upload files
spawn scp -o StrictHostKeyChecking=no app/api/admin/export/route.ts $user@$ip:$remote_path/app/api/admin/export/route.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

spawn scp -o StrictHostKeyChecking=no app/api/admin/export-logs/route.ts $user@$ip:$remote_path/app/api/admin/export-logs/route.ts
expect {
    "password:" { send "$password\r" }
}
expect eof

spawn scp -o StrictHostKeyChecking=no app/admin-db/page.tsx $user@$ip:$remote_path/app/admin-db/page.tsx
expect {
    "password:" { send "$password\r" }
}
expect eof

# Rebuild
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect {
    "password:" { send "$password\r" }
}
expect "#"
send "cd $remote_path && npm run build && pm2 restart all\r"
expect "#"
send "exit\r"
expect eof
