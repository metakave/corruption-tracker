#!/usr/bin/expect

set timeout 300
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set remote_path "/var/www/political_violence_tracker"

# Upload updated lib files
spawn scp -o StrictHostKeyChecking=no lib/ai-analysis.ts $user@$ip:$remote_path/lib/
expect "password:" { send "$password\r" }
expect eof

spawn scp -o StrictHostKeyChecking=no lib/event-processor.ts $user@$ip:$remote_path/lib/
expect "password:" { send "$password\r" }
expect eof

# Re-login to restart processes
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "password:" { send "$password\r" }
expect "#"

send "cd $remote_path\r"
expect "#"

# Restart processes to pick up lib changes
send "pm2 restart political-violence-tracker\r"
expect "#"

send "pm2 restart reprocess-job\r"
expect "#"

send "pm2 restart auto-scraper\r"
expect "#"

send "exit\r"
expect eof
