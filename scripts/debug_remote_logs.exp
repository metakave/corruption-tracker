#!/usr/bin/expect -f

set timeout 30

puts "📡 Connecting to check log files..."
spawn ssh -o StrictHostKeyChecking=no root@46.224.92.166
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"

expect "root@"
send "ls -F ~/.pm2/logs/\r"

expect "root@"
send "echo '--- TAILING OUT LOG ---'\r"
send "tail -n 20 ~/.pm2/logs/ai-pipeline-out.log\r"

expect "root@"
send "echo '--- TAILING ERROR LOG ---'\r"
send "tail -n 20 ~/.pm2/logs/ai-pipeline-error.log\r"

expect "root@"
send "exit\r"
expect eof
