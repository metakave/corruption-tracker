#!/usr/bin/expect

set timeout 30
set ip "46.224.92.166"
set user "root"
set password "qR0h7fHOfn/kBwoKfOAvVg=="
set config_path "/etc/nginx/sites-available/default"

spawn ssh -o StrictHostKeyChecking=no $user@$ip

expect {
    "password:" { send "$password\r" }
}
expect "#"

send "echo '--- READING NGINX CONFIG ---'\r"
send "cat $config_path\r"
expect "#"
send "exit\r"
expect eof
