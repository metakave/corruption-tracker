#!/usr/bin/expect -f

set timeout -1

puts "🚀 Uploading location update script to production..."
spawn scp -o StrictHostKeyChecking=no scripts/update_location_remote.ts root@46.224.92.166:/var/www/political_violence_tracker/scripts/
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"
expect eof

puts "🛠️  Running location update on server..."
spawn ssh -o StrictHostKeyChecking=no root@46.224.92.166
expect "password:"
send "qR0h7fHOfn/kBwoKfOAvVg==\r"

expect "root@"
send "cd /var/www/political_violence_tracker\r"

expect "#"
send "npx tsx scripts/update_location_remote.ts\r"

expect "#"
send "exit\r"
expect eof
